<h1>Lista de Productos</h1>
<ul>
    {{#each products}}
        <li> 
            <h2>{{this.title}}</h2> 
            <p>{{this.description}}</p> 
            <img src="{{this.thumbnails.[0]}}" alt="{{this.title}}" width="200"> 
            <p>Precio: ${{this.price}}</p> 
        </li>
    {{/each}}
</ul>
